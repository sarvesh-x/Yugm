EXPO_PUBLIC_API_URL=http://localhost:4000/api
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_LIVEKIT_URL=ws://localhost:7880

# Google Sign-In — get these from Firebase Console > Project Settings > General > Your apps
# Web client ID is needed for expo-auth-session (auto-created with Firebase project)
# Android client ID is listed under "Android apps" in the same section
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
