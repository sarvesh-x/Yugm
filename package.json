{
  "name": "yugm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,mobile -c saffron,magenta \"npm run dev:api\" \"npm run dev:mobile\"",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:mobile": "npm --workspace apps/mobile run dev",
    "seed": "npm --workspace apps/api run seed",
    "typecheck": "npm --workspaces --if-present run typecheck"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "~5.3.3"
  },
  "dependencies": {
    "expo-build-properties": "^56.0.19"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "fast-xml-parser": "^5.7.0",
    "postcss": "^8.5.10",
    "send": "^0.19.0",
    "tar": "^7.5.16",
    "@remix-run/server-runtime@2.17.5": {
      "turbo-stream": "3.2.0"
    },
    "@remix-run/server-runtime": {
      "turbo-stream": "3.2.0"
    },
    "turbo-stream": "3.2.0",
    "uuid": "^11.1.1"
  }
}
