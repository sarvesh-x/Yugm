{
  "name": "yugm-backend-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <27",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-d1-worker.mjs",
    "dev:admin": "npm --workspace apps/admin run dev",
    "build": "npm run build:admin && npm run build:api",
    "build:api": "npm --workspace apps/api run build",
    "test": "npm --workspaces --if-present run test",
    "test:d1-worker": "node --test apps/cloudflare-worker/test/auth-worker.mjs apps/cloudflare-worker/test/production-worker.mjs apps/cloudflare-worker/test/user-domain-integrity.mjs",
    "test:domain": "tsx --test apps/cloudflare-worker/test/vip-lifecycle.mts apps/cloudflare-worker/test/cosmetic-reward-cleanup.mts apps/cloudflare-worker/test/relationship-level-notice.mts",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "load:test": "node scripts/load-test-api.mjs",
    "secrets:check": "node scripts/check-tracked-secrets.mjs",
    "secrets:check:strict": "node scripts/check-tracked-secrets.mjs --strict",
    "test:secrets": "node --test scripts/check-tracked-secrets.test.mjs",
    "openapi:check": "node scripts/check-openapi.mjs",
    "audit:d1-endpoints": "tsx scripts/d1-endpoint-audit.mts",
    "d1:setup:local": "wrangler d1 migrations apply yugm --config apps/cloudflare-worker/auth-local/wrangler.jsonc --local",
    "d1:setup:production": "wrangler d1 migrations apply yugm --config apps/cloudflare-worker/wrangler.production.jsonc --remote",
    "d1:seed:sql": "tsx scripts/d1-reference-seed.mts",
    "d1:admin:sql": "tsx scripts/d1-admin-bootstrap.mts",
    "test:d1-setup": "node --test scripts/d1-reference-seed.test.mjs",
    "test:openapi": "node --test scripts/check-openapi.test.mjs",
    "config:manifest": "node scripts/config-backup-manifest.mjs",
    "test:config-manifest": "node --test scripts/config-backup-manifest.test.mjs",
    "worker-config:check": "node scripts/check-worker-config.mjs",
    "test:worker-config": "node --test scripts/check-worker-config.test.mjs",
    "build:admin": "npm --workspace apps/admin run build",
    "deploy": "npm run deploy:production --",
    "deploy:production": "wrangler deploy --config apps/cloudflare-worker/wrangler.production.jsonc",
    "deploy:dry-run:production": "wrangler deploy --dry-run --config apps/cloudflare-worker/wrangler.production.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "~5.3.3",
    "wrangler": "^4.164.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "fast-xml-parser": "^5.7.0",
    "postcss": "^8.5.10",
    "send": "^0.19.0",
    "tar": "^7.5.16",
    "@remix-run/server-runtime@2.17.5": {
      "turbo-stream": "3.2.0"
    },
    "@remix-run/server-runtime": {
      "turbo-stream": "3.2.0"
    },
    "turbo-stream": "3.2.0",
    "uuid": "^11.1.1"
  }
}
