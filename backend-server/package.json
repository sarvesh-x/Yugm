{
  "name": "yugm-backend-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-dev-or-start.cjs",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "start": "npm run start:api",
    "start:api": "npm --workspace apps/api run start",
    "env:check": "npm --workspace apps/api run env:check",
    "seed": "npm --workspace apps/api run seed",
    "seed:admin": "npm --workspace apps/api run seed:admin",
    "build": "npm run build:admin && npm run build:api",
    "build:api": "npm --workspace apps/api run build",
    "test": "npm --workspaces --if-present run test",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "load:test": "node scripts/load-test-api.mjs",
    "build:admin": "npm --workspace apps/admin run build"
  },
  "devDependencies": {
    "typescript": "~5.3.3"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13",
    "fast-xml-parser": "^5.7.0",
    "postcss": "^8.5.10",
    "send": "^0.19.0",
    "tar": "^7.5.16",
    "@remix-run/server-runtime@2.17.5": {
      "turbo-stream": "3.2.0"
    },
    "@remix-run/server-runtime": {
      "turbo-stream": "3.2.0"
    },
    "turbo-stream": "3.2.0",
    "uuid": "^11.1.1"
  }
}
