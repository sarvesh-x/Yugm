{
  "name": "@yugm/cloudflare-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/dev-d1-worker.mjs",
    "dev:auth": "node ../../scripts/dev-d1-worker.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.runtime.json",
    "test:production-worker": "node --test test/production-worker.mjs",
    "test:auth-worker": "node --test test/auth-worker.mjs",
    "test:restore-rehearsal": "tsx --test test/d1-restore-rehearsal.mts",
    "test:push-queue": "node --test test/push-queue.mjs",
    "dry-run:production": "wrangler deploy --dry-run --config wrangler.production.jsonc"
  },
  "dependencies": {
    "iconv-lite-worker": "npm:iconv-lite@^0.7.3"
  },
  "devDependencies": {
    "miniflare": "5.20261117.0-beta"
  }
}
