{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yugm-api-production",
  "main": "src/production.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "alias": {
    "iconv-lite": "iconv-lite-worker",
    "mongoose": "mongoose/index.js"
  },
  "vars": {
    "YUGM_STAGE": "production",
    "YUGM_PRODUCTION_ORIGIN": "https://api.yugm.invalid",
    "YUGM_R2_ENABLED": "true",
    "APP_CHECK_ENFORCE": "true"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "yugm-production",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "../api/migrations/d1"
    }
  ],
  "r2_buckets": [
    { "binding": "ASSETS", "bucket_name": "yugm-assets" },
    { "binding": "PUBLIC_MEDIA", "bucket_name": "yugm-public-media" },
    { "binding": "PRIVATE_MEDIA", "bucket_name": "yugm-private-media" },
    { "binding": "ORIGINALS", "bucket_name": "yugm-originals" },
    { "binding": "STAGING", "bucket_name": "yugm-staging" }
  ],
  "images": { "binding": "IMAGES" },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false, "persist": true },
    "traces": { "enabled": false }
  }
}
