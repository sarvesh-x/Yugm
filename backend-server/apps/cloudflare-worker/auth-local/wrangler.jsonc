{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "yugm-auth-local",
  "main": "../src/authLocal.ts",
  "compatibility_date": "2026-11-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "alias": {
    "iconv-lite": "iconv-lite-worker",
    "mongoose": "mongoose/index.js"
  },
  "vars": {
    "YUGM_STAGE": "local"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "yugm-auth-local",
      "database_id": "00000000-0000-4000-8000-000000000004",
      "remote": false
    }
  ]
}
