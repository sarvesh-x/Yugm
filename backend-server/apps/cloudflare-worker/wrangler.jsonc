{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yugm-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "iconv-lite": "iconv-lite-worker",
    "mongoose": "mongoose/index.js"
  },
  "durable_objects": {
    "bindings": [{ "name": "API_SERVICE", "class_name": "YugmApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["YugmApi"] }],
  "images": { "binding": "IMAGES" },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "vars": {
    "YUGM_STAGE": "local",
    "NODE_ENV": "production",
    "YUGM_RUNTIME": "cloudflare",
    "PORT": "4000",
    "MONGODB_URI": "mongodb://sarveshkumar10101:sarvesh121@ac-nh6iqql-shard-00-00.zl0la4t.mongodb.net:27017,ac-nh6iqql-shard-00-01.zl0la4t.mongodb.net:27017,ac-nh6iqql-shard-00-02.zl0la4t.mongodb.net:27017/?ssl=true&replicaSet=atlas-11zorg-shard-0&authSource=admin&appName=Cluster0",
    "MONGODB_DB_NAME": "YugmStaging",
