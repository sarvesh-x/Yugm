{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yugm-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "alias": {
    "iconv-lite": "iconv-lite-worker",
    "mongoose": "mongoose/index.js"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "API_SERVICE",
        "class_name": "YugmApi"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "YugmApi"
      ]
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  },
  "vars": {
    "YUGM_STAGE": "local",
    "NODE_ENV": "production",
    "YUGM_RUNTIME": "cloudflare",
    "PORT": "4000",
    "MONGODB_DB_NAME": "YugmStaging",
    "LIVEKIT_URL": "wss://yugm-j74hiyaw.livekit.cloud",
    "CORS_ORIGIN": "*",
    "FCM_PROJECT_ID": "yugm-e985e",
    "SEED_SUPER_ADMIN_EMAIL": "admin@yugm.local",
    "SEED_SUPER_ADMIN_NAME": "Yugm Super Admin",
    "RAZORPAY_KEY_ID": "rzp_test_U0Jjz9DTEReTaF",
    "STORAGE_DRIVER": "mongodb",
    "GOOGLE_PLAY_PACKAGE_NAME": "com.yugm.app",
    "GOOGLE_PLAY_SUBS_ENABLED": "false",
    "MONETIZATION_DIAMONDS_ENABLED": "false"
  }
}
