PORT=4000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/yugm
MONGODB_DB_NAME=Yugm
REDIS_URL=
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
JWT_SECRET=replace-me
ADMIN_JWT_SECRET=replace-me-admin-access
ADMIN_REFRESH_SECRET=replace-me-admin-refresh
ADMIN_PANEL_ORIGIN=http://localhost:5173
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_FIREBASE_UID=
SEED_SUPER_ADMIN_PASSWORD=
# Dev-only: set to any value (e.g., "123456") to bypass OTP verification in development
# Do NOT set this in production
DEV_BYPASS_OTP=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880
CORS_ORIGIN=*
# Firebase service account - required for both push notifications AND Google/Phone auth
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Razorpay server-side order creation and signature verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Play server-side purchase verification
GOOGLE_PLAY_PACKAGE_NAME=com.example.yugm
GOOGLE_PLAY_CLIENT_EMAIL=
GOOGLE_PLAY_PRIVATE_KEY=
