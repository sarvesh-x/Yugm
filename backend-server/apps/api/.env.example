# ── Yugm API Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your values before running the server.
# Required values are marked with (required); everything else is optional.

PORT=4000

# ── Database ─────────────────────────────────────────────────────────
# (required) MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/yugm
# Database name inside the cluster (default: Yugm)
MONGODB_DB_NAME=Yugm
# Redis URL for real-time features and rate limiting (optional, leave empty for in-memory fallback)
REDIS_URL=

# ── File Storage ─────────────────────────────────────────────────────
# Driver: "local" (default, saves to ./uploads) or "s3" for production
STORAGE_DRIVER=local
# S3 credentials — only needed when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Auth / Security ──────────────────────────────────────────────────
# (required) Strong random string used to sign auth JWTs
# Generate: openssl rand -hex 64
JWT_SECRET=replace-me

# (required) Encryption key for Creator Payout KYC sensitive fields (PAN, UPI, bank account)
# Must be exactly 32 hex characters (64 chars). Generate: openssl rand -hex 32
PAYOUT_KYC_ENCRYPTION_KEY=

# Admin panel JWT secrets — should differ from JWT_SECRET
ADMIN_JWT_SECRET=replace-me-admin-access
ADMIN_REFRESH_SECRET=replace-me-admin-refresh

# (required for admin panel CORS) Origin of the admin panel UI
ADMIN_PANEL_ORIGIN=http://localhost:5173

# Super admin seeding — only used on first run when no admin users exist
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_FIREBASE_UID=
SEED_SUPER_ADMIN_PASSWORD=

# Dev-only: set to any value (e.g., "123456") to bypass OTP verification in development
# Do NOT set this in production
DEV_BYPASS_OTP=

# ── LiveKit (Real-time Voice/Video) ──────────────────────────────────
# (required for voice/video rooms) LiveKit API credentials
# Create a project at https://livekit.io and generate keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://localhost:7880

# ── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ── Firebase / FCM (Push Notifications + Auth) ──────────────────────
# (required for push notifications + Google/Phone auth)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ── Payments ─────────────────────────────────────────────────────────
# Razorpay (India) — required for INR recharge
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for receiving payout status updates from Razorpay
# Set up at Dashboard > Settings > Webhooks > Add webhook: POST /api/payments/webhook/payout
RAZORPAY_WEBHOOK_SECRET=

# Google Play Billing — required for Android in-app purchases
# Set up at Google Play Console > Monetise > Products > In-app products
GOOGLE_PLAY_PACKAGE_NAME=com.yugm.app
# Service account email and private key from Google Cloud Console for purchase verification
GOOGLE_PLAY_CLIENT_EMAIL=
# The full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----
GOOGLE_PLAY_PRIVATE_KEY=
